# ==============================================================================
# GuWorld - Root Environment Template
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=gu_admin
POSTGRES_PASSWORD=gu_pass_123
POSTGRES_DB=gu_db

# Backend container image (for production docker-compose)
BACKEND_IMAGE=ghcr.io/vippro67/guworld-backend:latest

# TLS / WebTransport (false for local dev HTTP, true for production HTTPS/WT)
TLS_ENABLED=false
WT_ENABLED=false

# Database Connection (fallback if backend is started from root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gu_admin
DB_PASSWORD=gu_pass_123
DB_NAME=gu_db
DB_SSLMODE=disable

# Redis Cache (fallback if backend is started from root)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Backend App Configuration
PORT=8080
GIN_MODE=debug
PROD_ENV=development
JWT_SECRET=guworld_cultivation_secret_key_change_me_local_development
COMBAT_MAX_GU_ACTIONS_PER_TURN=3
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
WS_FALLBACK_ENABLED=true
