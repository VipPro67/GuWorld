# Copy this file to .env and fill in production values.

PORT=8080
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=gu_db
DB_SSLMODE=require

JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Compose uses the local Redis service by default.
REDIS_PASSWORD=
INTERNAL_BACKEND_URL=http://backend:8080

# Optional backend integrations. Keep values empty if unused.
PROD_ENV=production
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=