# Copy this file to .env and fill in production values.

PORT=8080
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=gu_db
DB_SSLMODE=require

JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Compose uses the local Redis service by default.
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL=false
REDIS_TLS_SERVER_NAME=
REDIS_TLS_CA_FILE=
INTERNAL_BACKEND_URL=http://backend:8080

# Optional backend integrations. Keep values empty if unused.
PROD_ENV=production
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CF_ENDPOINT=
CF_BUCKET=
CF_KEY=
CF_SEC=
CF_PUBLIC_BASE_URL=https://cdn.cogioi.io.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
LOKI_URL=
LOKI_USER=
PROMETHEUS_URL=
PROMETHEUS_USER=
GRAFANA_API_KEY=

# Realtime MMO is enabled for all signed-in players; public maps are loaded
# automatically from MMO_MAP_DIR. Map/content versions are fixed in source.
MMO_MAX_PLAYERS_PER_ZONE=5
MMO_INSTANCES_PER_ZONE=1
MMO_MAP_DIR=data/mmo/maps
MMO_GU_PROFILES=data/mmo/gu/transpiled_profiles.json

# Monster/boss stat tuning (restart backend after changing).
# Rank scaling on by default; false/0/off/no keeps only type + sub-rank multipliers.
MONSTER_RANK_SCALING_ENABLED=true
# Global HP/ATK/DEF multiplier applied after all other scaling (1.0 = unchanged).
MONSTER_STAT_MULTIPLIER=1.0
# Frontend map selection fallback. Player's current region takes precedence.
NEXT_PUBLIC_MMO_ZONE_ID=
NEXT_PUBLIC_MMO_MAP_URL=
