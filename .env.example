# Copy this file to .env and fill in production values.

PORT=8080
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=gu_db
DB_SSLMODE=require

JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Compose uses the local Redis service by default.
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL=false
REDIS_TLS_SERVER_NAME=
REDIS_TLS_CA_FILE=
INTERNAL_BACKEND_URL=http://backend:8080

# Optional backend integrations. Keep values empty if unused.
PROD_ENV=production
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CF_ENDPOINT=
CF_BUCKET=
CF_KEY=
CF_SEC=
CF_PUBLIC_BASE_URL=https://cdn.cogioi.io.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
LOKI_URL=
LOKI_USER=
PROMETHEUS_URL=
PROMETHEUS_USER=
GRAFANA_API_KEY=

# Realtime MMO (default OFF). Keep admission allowlisted until rollout gates pass.
REALTIME_WORLD_ENABLED=false
# Comma-separated region/map ids. Use "all" or "*" to load every JSON in MMO_MAP_DIR
# whose map_version/content_version matches the two values below (required when
# testing edge transitions across the generated KHU_VUC maps).
MMO_ZONE_IDS=
MMO_ALLOWLIST=
MMO_MAX_PLAYERS_PER_ZONE=5
MMO_INSTANCES_PER_ZONE=1
MMO_MAP_VERSION=
MMO_CONTENT_VERSION=
MMO_MAP_DIR=data/mmo/maps
MMO_GU_PROFILES=data/mmo/gu/transpiled_profiles.json
MMO_ADMISSION_PAUSED=false
PHASER_WORLD_CLIENT_ENABLED=false

# Frontend public flags. Zone/map/content must match the backend values above.
NEXT_PUBLIC_REALTIME_WORLD_ENABLED=false
NEXT_PUBLIC_PHASER_WORLD_CLIENT_ENABLED=false
NEXT_PUBLIC_MMO_ZONE_ID=
NEXT_PUBLIC_MMO_MAP_VERSION=
NEXT_PUBLIC_MMO_CONTENT_VERSION=
NEXT_PUBLIC_MMO_MAP_URL=
