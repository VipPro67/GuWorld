  "cards": [
    { "dot": "cyan", "title": "REST API", "items": [
      "Gameplay rules live in backend/internal/handlers (~280 files); combat files carry the combat- prefix",
      "Movement has one guard chain: ownership → bounds → combat-free → destination → publish (movement.go)",
      "playerstate owns the canonical players-row projection; handlers and services never re-derive the row shape",
      "Most handlers write Postgres directly with *sql.Tx instead of going through the five shared services"
    ] },
    { "dot": "emerald", "title": "Realtime zones", "items": [
      "Zone sim: deterministic 20 Hz tick — combat, damage, monster AI, statuses — with no I/O in the tick loop",
      "Zone manager owns leases, lazy zone start and AOI-filtered snapshot broadcast — process-local, not via Redis",
      "Zone state persists on join/leave and a 10 s realtime-checkpoint worker (gateway.CheckpointActive)",
      "The hub also subscribes Redis pub/sub (player:*, chat:*, trade:*, world:*, combat:*, notif:*) for cross-actor fan-out"
    ] },
    { "dot": "rose", "title": "Data-driven gameplay", "items": [
      "Gu · Item · Constitution · Race dictionaries load from Postgres into in-memory registries at startup; admin CSV import (Admin → “Dữ liệu”) + restart refreshes them",
      "Gu effect profiles compile against the Gu catalog at boot (CompileCatalog); the compiled hotbar skills are injected straight into the zone manager's runtime",
      "unsupported authored blocks fail closed so live hotbars stay empty"
    ] },
    { "dot": "violet", "title": "Sessions & events", "items": [
      "Auth middleware validates JWT sessions with a Redis cache and Postgres fallback; Redis-off startup degrades to in-memory fallbacks",
      "Handlers publish player:/chat:/trade: events to Redis pub/sub; the hub's Redis subscribers fan them out to clients",
      "BatchPersister worker flushes queued Redis writes into Postgres every 5 s",
      "Frontend consumes events over the same /api/ws WebSocket — no separate SSE channel in the current code"
    ] }
  ]
