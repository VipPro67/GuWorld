# ==============================================================================
# GuWorld Frontend - Environment Configuration Template
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Backend API base URL for client-side fetch calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Backend API base URL for SSR / server-side fetch (falls back to NEXT_PUBLIC_BACKEND_URL)
INTERNAL_BACKEND_URL=http://localhost:8080

# Realtime WebSocket URL (local fallback for WebTransport)
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8080/api/ws

# Optional Realtime WebTransport URL (keep empty for local dev to use WebSocket)
NEXT_PUBLIC_REALTIME_URL=

# Frontend site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maintenance mode switch (false = normal operation)
NEXT_PUBLIC_MAINTENANCE_MODE=false
