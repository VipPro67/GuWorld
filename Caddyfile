www.cogioi.io.vn {
    redir https://cogioi.io.vn{uri} permanent
}

cogioi.io.vn {
    encode zstd gzip
    reverse_proxy frontend:3000
}

api.cogioi.io.vn {
    @events {
        path /api/events*
        path /api/player/events*
        path /api/trade/events*
        path /api/chat/bao-hoang/events*
    }

    handle @events {
        reverse_proxy backend:8080 {
            flush_interval -1

            transport http {
                response_header_timeout 0
                keepalive 120s
                keepalive_idle_conns 500
            }
        }
    }

    handle {
        encode zstd gzip
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
                keepalive 60s
                keepalive_idle_conns 100
            }
        }
    }
}