# ==============================================================================
# GuWorld Backend - Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=8080
GIN_MODE=debug
PROD_ENV=development
LOG_LEVEL=INFO

# Require an email OTP before account registration (default: false)
REQUIRE_EMAIL_VERIFICATION=false

# Database Connection (PostgreSQL)
# Default DB values match docker-compose (gu_admin / gu_pass_123 / gu_db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gu_admin
DB_PASSWORD=gu_pass_123
DB_NAME=gu_db
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TX_TIMEOUT_MS=15000
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=10

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECT_ATTEMPTS=8
REDIS_CONNECT_DELAY_MS=1000

# Authentication & Security
JWT_SECRET=guworld_cultivation_secret_key_change_me_local_development
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# TLS & WebTransport
# For local dev without TLS certs, keep both false.
# Server serves plain HTTP on :8080 with WebSocket fallback at /api/ws.
TLS_ENABLED=false
WT_ENABLED=false
WS_FALLBACK_ENABLED=true
TLS_ADDR=:8443
WT_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# Realtime MMO World Configuration
MMO_MAX_PLAYERS_PER_ZONE=5
MMO_INSTANCES_PER_ZONE=1
MMO_MAP_DIR=data/mmo/maps
MMO_GU_PROFILES=data/mmo/gu/transpiled_profiles.json

# Gameplay Mechanics Flags
REGIONAL_WALL_SUPPRESSION_ENABLED=true
MONSTER_RANK_SCALING_ENABLED=true
MONSTER_STAT_MULTIPLIER=1.0
# Maximum Gu/Killer Move actions in one turn-based combat plan (1-10, default 3).
COMBAT_MAX_GU_ACTIONS_PER_TURN=3

# Rate Limiting & Anti-abuse
AUTO_BAN_FINGERPRINT_LIMIT=5
AUTO_BAN_REFERRAL_LIMIT=5
AUTO_BAN_DURATION_HOURS=72
AUTO_BAN_BLOCK_DEVICE=true

# Optional: Email / SMTP (leave empty to disable OTP emails locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: Google OAuth (leave empty to disable Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: Cloudflare R2 for Avatar Storage (leave empty for local fallback)
CF_ENDPOINT=
CF_BUCKET=
CF_KEY=
CF_SEC=
CF_PUBLIC_BASE_URL=

# Optional: PayOS Payment (leave empty to disable topup)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
